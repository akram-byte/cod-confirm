# Copy to .env (never committed) for the AI voiceover: npm run tts
# elevenlabs.io → Developers → API keys → create a key with "Text to Speech" access
ELEVENLABS_API_KEY=""
# Voice Library → pick a voice → "Add to my voices" → in My Voices, "Copy voice ID"
ELEVENLABS_VOICE_ID=""
# eleven_v3 (most expressive, best with dialect) or eleven_multilingual_v2 (steadier)
ELEVENLABS_MODEL="eleven_v3"

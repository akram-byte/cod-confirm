// COD Confirm — database schema.
// Money is always stored as integers in DZD.
// Wilayas and communes live in src/data/algeria.json (not in the database).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  NEW
  CONFIRMED
  NO_ANSWER
  CALLBACK
  CANCELLED
  SHIPPED
  DELIVERED
  RETURNED
}

enum DeliveryType {
  HOME
  DESK
}

enum OrderSource {
  FORM
  MANUAL
}

enum RescueResult {
  WILL_RECEIVE
  NO_ANSWER
  REFUSED
}

enum CallOutcome {
  CONFIRMED
  NO_ANSWER
  CALLBACK
  CANCELLED
}

// Single row (id = 1): store settings and the owner password.
model Settings {
  id               Int      @id @default(1)
  storeName        String   @default("")
  passwordHash     String
  whatsappTemplate String   @default("")
  courierSyncedAt  DateTime? // last time parcel statuses were read from the courier
  fbPixelId        String    @default("") // Meta (Facebook/Instagram) Pixel ID, public
  tiktokPixelId    String    @default("") // TikTok Pixel ID, public
  telegramChatId   String    @default("") // seller's Telegram chat for order alerts ("" = not connected)
  telegramCode     String    @default("") // one-time code while connecting
  telegramLocale   String    @default("ar") // language of the alerts
  telegramDaily    Boolean   @default(true) // evening summary
  callerPasswordHash String  @default("") // optional second login for someone who only calls customers ("" = off)
  updatedAt        DateTime @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Int // DZD
  cost        Int         @default(0) // DZD, buying cost per unit
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
  drafts      OrderDraft[]
  adSpends    ProductAdSpend[]
}

model Customer {
  id              String   @id @default(cuid())
  phone           String   @unique // normalized: 0XXXXXXXXX
  name            String
  blacklisted     Boolean  @default(false)
  blacklistReason String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
}

model Order {
  id             String       @id @default(cuid())
  number         Int          @unique @default(autoincrement()) // shown to the seller (#1024)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  customerName   String
  phone          String
  wilayaCode     Int
  communeId      Int
  communeName    String
  address        String?
  deliveryType   DeliveryType @default(HOME)
  deliveryFee    Int          @default(0) // DZD charged to the customer
  subtotal       Int // DZD, sum of items
  total          Int // DZD, subtotal + deliveryFee
  status         OrderStatus  @default(NEW)
  source         OrderSource  @default(FORM)
  attempts       Int          @default(0)
  duplicate      Boolean      @default(false) // same phone + same product within 24h
  // Fake-order signals (public form only): warnings for the seller, orders are never blocked.
  fillSeconds    Int? // seconds from first touch of the form to sending it
  deviceId       String? // random id kept in the customer's browser
  fastFill       Boolean      @default(false) // form sent too fast for a person
  sharedDevice   Boolean      @default(false) // this browser sent orders for several different phones
  callbackAt     DateTime?
  trackingNumber String?
  courier        String? // "yalidine" / "zrexpress" / "demo" when the parcel was created through the courier API
  courierStatus  String? // courier's own status text, e.g. "Sorti en livraison"
  labelUrl       String? // printable shipping label from the courier
  stopDeskId     String? // courier office chosen for DESK delivery (Yalidine number or ZR hub id)
  stopDeskName   String?
  returnCost     Int          @default(0) // DZD lost on a returned parcel
  // "Save the parcel": the courier could not deliver; the seller calls the customer before it comes back.
  failedAt       DateTime? // last failed delivery attempt (courier status or marked by hand)
  rescueOpen     Boolean      @default(false) // waiting for the seller's call
  rescueResult   RescueResult?
  rescueCalls    Int          @default(0)
  rescueNote     String?
  rescuedAt      DateTime?
  // Courier cash check: set when the courier paid the seller for this parcel.
  payoutId       String?
  payout         Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  note           String?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  returnedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
  calls          CallLog[]

  @@index([status, createdAt])
  @@index([rescueOpen, status])
  @@index([status, payoutId])
  @@index([phone])
  @@index([deviceId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String // snapshot at order time
  quantity    Int      @default(1)
  unitPrice   Int // DZD snapshot
  unitCost    Int      @default(0) // DZD snapshot

  @@index([orderId])
  @@index([productId])
}

model CallLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  outcome   CallOutcome
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model DeliveryFee {
  wilayaCode Int      @id
  homeFee    Int // DZD
  deskFee    Int // DZD
  active     Boolean  @default(true) // false = we don't deliver there
  deskOnly   Boolean  @default(false) // true = stop desk only (home delivery returns too often)
  updatedAt  DateTime @updatedAt
}

model AdSpend {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  amount    Int // DZD
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Ad spend for one product on one day (a campaign for that product). Counted on top of
/// AdSpend (spend not tied to a product). Used for cost per delivered order per product.
model ProductAdSpend {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount    Int // DZD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, productId])
  @@index([productId])
}

/// Spam and login limits, kept in the database so they hold on serverless hosting too.
/// One row per key (e.g. "order:1.2.3.4"); expired rows are reused or cleaned by the daily cron.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Money the courier paid to the seller, for a set of delivered (and returned) parcels.
model Payout {
  id         String   @id @default(cuid())
  receivedAt DateTime // day the seller got the money
  amount     Int // DZD actually received
  expected   Int // DZD the seller should have received for these parcels (estimate)
  collected  Int // DZD the courier collected from customers for these parcels
  note       String?
  createdAt  DateTime @default(now())
  orders     Order[]

  @@index([receivedAt])
}

enum DraftStatus {
  OPEN // phone typed, order not sent
  NO_ANSWER // seller called, no answer
  ORDERED // the customer sent the order after all
  RECOVERED // the seller made the order from it
  DISMISSED // not interested
}

/// Abandoned order: the customer typed a valid phone on the order form but never sent it.
model OrderDraft {
  id           String      @id @default(cuid())
  token        String      @unique // random id from the customer's browser, one per form visit
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  phone        String
  customerName String?
  wilayaCode   Int?
  communeId    Int?
  quantity     Int         @default(1)
  status       DraftStatus @default(OPEN)
  attempts     Int         @default(0)
  orderId      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, updatedAt])
  @@index([phone])
}

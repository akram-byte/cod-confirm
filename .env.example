# Copy this file to .env and fill in the values. Never commit .env.

# Neon PostgreSQL (https://console.neon.tech → Connect).
# Pooled connection string (host contains "-pooler"), used by the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (non-pooled) connection string, used by Prisma migrations and seed:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Secret used to sign the login session cookie (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Owner password set by the seed on first setup (min 8 characters).
# It can be changed later in Settings.
OWNER_PASSWORD=""

# Courier (optional). Leave COURIER empty to ship with the Excel/CSV export only.
#   demo     = fake courier for development and demos (no account needed)
#   yalidine  = Yalidine API (keys from yalidine.app → Développement → API)
#   zrexpress = ZR Express API (keys from the ZR Express space → API; ask ZR to activate API access)
COURIER=""
YALIDINE_API_ID=""
YALIDINE_API_TOKEN=""
ZREXPRESS_API_KEY=""
ZREXPRESS_TENANT_ID=""
# Wilaya code the seller ships from (e.g. 16 for Alger). Used by Yalidine.
COURIER_FROM_WILAYA=""

# Telegram alerts (optional, free). Create a bot with @BotFather in Telegram and paste its token.
# The seller then connects from Settings → Alertes Telegram.
TELEGRAM_BOT_TOKEN=""
# Protects /api/cron/daily (evening summary). Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=""
